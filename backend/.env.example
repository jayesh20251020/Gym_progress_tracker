# Copy this file to .env and replace every placeholder. Never commit .env.
# For Render, set DATABASE_URL to the database's Internal Database URL.
# Local development can instead use the five DB_* variables below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ironlog
DB_USER=ironlog_app
DB_PASSWORD=replace-with-a-strong-database-password

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-random-secret-key
FLASK_ENV=development

# Comma-separated browser origins that may call this API.
FRONTEND_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
